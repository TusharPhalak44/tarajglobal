n.text-xl {\r\n  font-size: 1.25rem;\r\n  line-height: 1.75rem;\r\n}\r\n\r\n.text-2xl {\r\n  font-size: 1.5rem;\r\n  line-height: 2rem;\r\n}\r\n\r\n.text-3xl {\r\n  font-size: 1.875rem;\r\n  line-height: 2.25rem;\r\n}\r\n\r\n.text-4xl {\r\n  font-size: 2.25rem;\r\n  line-height: 2.5rem;\r\n}\r\n\r\n.text-5xl {\r\n  font-size: 3rem;\r\n  line-height: 1;\r\n}\r\n\r\n.text-6xl {\r\n  font-size: 3.75rem;\r\n  line-height: 1;\r\n}\r\n\r\n/* Font Weights */\r\n.font-light {\r\n  font-weight: 300;\r\n}\r\n\r\n.font-normal {\r\n  font-weight: 400;\r\n}\r\n\r\n.font-medium {\r\n  font-weight: 500;\r\n}\r\n\r\n.font-semibold {\r\n  font-weight: 600;\r\n}\r\n\r\n.font-bold {\r\n  font-weight: 700;\r\n}\r\n\r\n.font-extrabold {\r\n  font-weight: 800;\r\n}\r\n\r\n/* Heading Styles */\r\nh1, h2, h3, h4, h5, h6 {\r\n  font-family: var(--font-heading);\r\n  font-weight: 700;\r\n  line-height: 1.2;\r\n  color: var(--color-text-primary);\r\n}\r\n\r\nh1 {\r\n  font-size: 3rem;\r\n}\r\n\r\nh2 {\r\n  font-size: 2.25rem;\r\n}\r\n\r\nh3 {\r\n  font-size: 1.875rem;\r\n}\r\n\r\nh4 {\r\n  font-size: 1.5rem;\r\n}\r\n\r\nh5 {\r\n  font-size: 1.25rem;\r\n}\r\n\r\nh6 {\r\n  font-size: 1.125rem;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  h1 {\r\n    font-size: 2.25rem;\r\n  }\r\n  \r\n  h2 {\r\n    font-size: 1.875rem;\r\n  }\r\n  \r\n  h3 {\r\n    font-size: 1.5rem;\r\n  }\r\n}\r\n/* ── Taraj Global Animation System ─────────────────────────────────────── */\n\n:root {\n  --ease-smooth: cubic-bezier(0.22, 1, 0.36, 1);\n  --ease-spring: cubic-bezier(0.16, 1, 0.3, 1);\n  --ease-in-out-smooth: cubic-bezier(0.65, 0, 0.35, 1);\n}\n\n/* Fade In */\n@keyframes fadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n.animate-fade-in {\n  animation: fadeIn 0.6s var(--ease-smooth) forwards;\n}\n\n/* Fade In Up */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in-up {\n  animation: fadeInUp 0.7s var(--ease-smooth) forwards;\n}\n\n/* Fade In Down */\n@keyframes fadeInDown {\n  from {\n    opacity: 0;\n    transform: translateY(-20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.animate-fade-in-down {\n  animation: fadeInDown 0.7s var(--ease-smooth) forwards;\n}\n\n/* Slide In Left */\n@keyframes slideInLeft {\n  from {\n    opacity: 0;\n    transform: translateX(-30px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n.animate-slide-in-left {\n  animation: slideInLeft 0.7s var(--ease-smooth) forwards;\n}\n\n/* Slide In Right */\n@keyframes slideInRight {\n  from {\n    opacity: 0;\n    transform: translateX(30px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n.animate-slide-in-right {\n  animation: slideInRight 0.7s var(--ease-smooth) forwards;\n}\n\n/* Scale In */\n@keyframes scaleIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n.animate-scale-in {\n  animation: scaleIn 0.6s var(--ease-smooth) forwards;\n}\n\n/* Subtle Floating Pulse */\n@keyframes floatSlow {\n  0%, 100% {\n    transform: translateY(0px);\n  }\n  50% {\n    transform: translateY(-8px);\n  }\n}\n\n.animate-float {\n  animation: floatSlow 4s ease-in-out infinite;\n}\n\n/* Shimmer Light Bar */\n@keyframes shimmer {\n  0% {\n    transform: translateX(-100%);\n  }\n  100% {\n    transform: translateX(200%);\n  }\n}\n\n.animate-shimmer {\n  animation: shimmer 2.5s infinite;\n}\n\n/* Smooth Glow Pulse */\n@keyframes glowPulse {\n  0%, 100% {\n    opacity: 0.4;\n    filter: drop-shadow(0 0 10px rgba(0, 166, 255, 0.3));\n  }\n  50% {\n    opacity: 0.9;\n    filter: drop-shadow(0 0 25px rgba(0, 166, 255, 0.6));\n  }\n}\n\n.animate-glow-pulse {\n  animation: glowPulse 3s ease-in-out infinite;\n}\n\n/* Data Stream Movement */\n@keyframes dataStream {\n  0% {\n    stroke-dashoffset: 100;\n  }\n  100% {\n    stroke-dashoffset: 0;\n  }\n}\n\n.animate-data-stream {\n  stroke-dasharray: 8, 8;\n  animation: dataStream 2s linear infinite;\n}\n\n/* Infinite Marquee */\n@keyframes marqueeScroll {\n  0% {\n    transform: translateX(0);\n  }\n  100% {\n    transform: translateX(-50%);\n  }\n}\n\n.animate-marquee {\n  display: flex;\n  width: -moz-max-content;\n  width: max-content;\n  animation: marqueeScroll 25s linear infinite;\n}\n\n.animate-marquee:hover {\n  animation-play-state: paused;\n}\n\n/* ── Global Section Laser Divider ────────────────────────────────────────── */\n.global-section-laser-divider {\n  position: absolute;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: rgba(255, 255, 255, 0.08);\n  overflow: hidden;\n  z-index: 20;\n  pointer-events: none;\n  transition: background-color 0.3s ease;\n}\n\n.light .global-section-laser-divider,\n:root:not(.dark) .global-section-laser-divider {\n  background: rgba(0, 0, 0, 0.07);\n}\n\n.laser-pos-bottom {\n  bottom: 0;\n}\n\n.laser-pos-top {\n  top: 0;\n}\n\n.global-laser-beam {\n  position: absolute;\n  top: 0;\n  height: 100%;\n  width: 300px;\n  filter: drop-shadow(0 0 8px currentColor);\n  animation: globalLaserSweep 8s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n}\n\n.global-laser-cyan {\n  color: #00A6FF;\n  background: linear-gradient(90deg, transparent 0%, rgba(0, 166, 255, 0.95) 50%, rgba(56, 189, 248, 0.8) 80%, transparent 100%);\n}\n\n.global-laser-amber {\n  color: #FF6D00;\n  animation-delay: 4s;\n  background: linear-gradient(90deg, transparent 0%, rgba(255, 109, 0, 0.95) 50%, rgba(251, 146, 60, 0.8) 80%, transparent 100%);\n}\n\n@keyframes globalLaserSweep {\n  0% {\n    left: -320px;\n    opacity: 0;\n  }\n  15% {\n    opacity: 1;\n  }\n  85% {\n    opacity: 1;\n  }\n  100% {\n    left: 100%;\n    opacity: 0;\n  }\n}\n\n/* ── Accessibility: prefers-reduced-motion ─────────────────────────────── */\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n  \n  .animate-marquee {\n    animation: none !important;\n  }\n\n  .animate-float,\n  .animate-glow-pulse,\n  .animate-shimmer,\n  .global-laser-beam {\n    animation: none !important;\n    display: none !important;\n  }\n}\r\n/* Container */\r\n.container {\r\n  width: 100%;\r\n  max-width: 1280px;\r\n  margin: 0 auto;\r\n  padding: 0 var(--spacing-lg);\r\n}\r\n\r\n@media (max-width: 1024px) {\r\n  .container {\r\n    max-width: 1024px;\r\n  }\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .container {\r\n    max-width: 768px;\r\n    padding: 0 var(--spacing-md);\r\n  }\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .container {\r\n    max-width: 640px;\r\n    padding: 0 var(--spacing-sm);\r\n  }\r\n}\r\n\r\n/* Section */\r\n.section {\r\n  padding: var(--spacing-3xl) 0;\r\n}\r\n\r\n.section-sm {\r\n  padding: var(--spacing-xl) 0;\r\n}\r\n\r\n.section-lg {\r\n  padding: var(--spacing-3xl) 0;\r\n}\r\n\r\n/* Flex Utilities */\r\n.flex-center {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.flex-between {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.flex-start {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n}\r\n\r\n.flex-end {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n}\r\n\r\n/* Grid Utilities */\r\n.grid-auto-fit {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\r\n  gap: var(--spacing-lg);\r\n}\r\n\r\n.grid-auto-fill {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\r\n  gap: var(--spacing-lg);\r\n}\r\n\r\n/* Text Utilities */\r\n.text-center {\r\n  text-align: center;\r\n}\r\n\r\n.text-left {\r\n  text-align: left;\r\n}\r\n\r\n.text-right {\r\n  text-align: right;\r\n}\r\n\r\n.text-justify {\r\n  text-align: justify;\r\n}\r\n\r\n/* Truncate */\r\n.truncate {\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.line-clamp-2 {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 2;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.line-clamp-3 {\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Screen Reader Only */\r\n.sr-only {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border-width: 0;\r\n}\r\n\r\n/* Focus Visible */\r\n.focus-visible:focus-visible {\r\n  outline: 2px solid var(--color-primary);\r\n  outline-offset: 2px;\r\n}\r\n\r\n/* Disabled */\r\n.disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n  pointer-events: none;\r\n}\r\n\r\n/* Loading */\r\n.loading {\r\n  position: relative;\r\n  pointer-events: none;\r\n}\r\n\r\n.loading::after {\r\n  content: '';\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 1rem;\r\n  height: 1rem;\r\n  margin: -0.5rem 0 0 -0.5rem;\r\n  border: 2px solid var(--color-border);\r\n  border-top-color: var(--color-primary);\r\n  border-radius: 50%;\r\n  animation: spin 0.6s linear infinite;\r\n}\r\n/* Navbar Styles */\n\n.navbar-glass {\n  backdrop-filter: blur(10px);\n  -webkit-backdrop-filter: blur(10px);\n}\n\n.navbar-link {\n  position: relative;\n}\n\n.navbar-link::after {\n  content: '';\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 0;\n  height: 2px;\n  background-color: currentColor;\n  transition: width 0.3s ease;\n}\n\n.navbar-link:hover::after {\n  width: 100%;\n}\n\n.navbar-link.active::after {\n  width: 100%;\n}\n\n/* Mobile Menu Animation */\n.mobile-menu-overlay {\n  background-color: rgba(0, 0, 0, 0.5);\n}\n\n.mobile-menu-content {\n  background-color: white;\n  box-shadow: -4px 0 15px rgb