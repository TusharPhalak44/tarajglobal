NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3001
# Public canonical domain used in sitemap.xml and robots.txt
SITE_URL=https://tarajglobal.com

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tarajglobal

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Leave false in production; staff accounts are created from Admin > Users.
ALLOW_PUBLIC_REGISTRATION=false

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
ADMIN_EMAIL=
CAREER_EMAIL=
HR_EMAIL=
